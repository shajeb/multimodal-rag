# Demo needs no API keys or downloaded models.
AI_MODE=demo
AI_DATA_DIR=data/demo
VECTOR_BACKEND=local
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
LLM_PROVIDER=gemini
# Live image ingestion requires Gemini vision, including when Grok answers.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Optional xAI/Grok provider. API usage is paid; disabled by default.
GROK_API_KEY=
GROK_MODEL=grok-4.6
FALLBACK_PROVIDER=
PINECONE_API_KEY=
PINECONE_INDEX_HOST=
REDIS_URL=
# Map unique bearer tokens to tenant IDs to use the HTTP API.
AI_API_TOKENS={}
